{
  "rules": {
    "activeScreen": {
      ".read": false,
      ".write": false
    },
    "passwords": {
      ".read": false,
      "$eventId": {
        ".write": "!data.exists()"
      }
    },
    "recyclebin": {
      ".read": false,
      ".write": true
    },
    "leads": {
      ".read": false,
      ".write": true
    },
    "eventIndex": {
      ".read": true,
      "$eventId": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChild('createdAt')"
      }
    },
    "events": {
      "$eventId": {
        ".write": "!newData.exists()",
        "meta": {
          ".read": true,
          ".write": true,
          ".validate": "newData.hasChildren(['organizerName', 'organizerPhone', 'celebrantName', 'eventDate'])",
          "organizerName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 100" },
          "organizerPhone": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 20" },
          "celebrantName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 100" },
          "eventDate": { ".validate": "newData.isString()" },
          "notifyEmail": { ".validate": "newData.isString() && newData.val().length < 200" }
        },
        "blessings": {
          ".read": true,
          ".indexOn": ["createdAt", "status"],
          "$blessingId": {
            ".write": "!data.exists() || !newData.exists()",
            ".validate": "newData.hasChildren(['name', 'text', 'createdAt']) && !newData.hasChild('status') && !newData.hasChild('rejectReason')",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 100" },
            "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 5000" },
            "photoDataUrl": { ".validate": "newData.isString() && newData.val().length < 5000000 && newData.val().matches(/^data:image\\/(jpeg|jpg|png|gif|webp);base64,[A-Za-z0-9+\\/]+=*$/)" },
            "status": { ".validate": "newData.isString() && (newData.val() === 'pending' || newData.val() === 'approved' || newData.val() === 'rejected')" }
          }
        },
        "screenControl": {
          ".read": true,
          ".write": true
        }
      }
    }
  }
}
